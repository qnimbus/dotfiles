#!/bin/bash

# Script: run_onchange_before_08-install-wslu.sh
# Description: Install wslu (provides wslview, used as $BROWSER) on WSL Ubuntu
# Author: {{ .chezmoi.username }}
# Machine: {{ .chezmoi.hostname }}
# OS: {{ .chezmoi.os }}/{{ .chezmoi.arch }}
# Version: 1.0

{{ if and .wsl (eq .osid "linux-ubuntu") (not .ephemeral) -}}

set -euo pipefail

log() { echo "[$(date "+%Y-%m-%d %H:%M:%S")] [$1] ${*:2}"; }

if command -v wslview &> /dev/null; then
    log INFO "wslu is already installed: $(wslview --version 2>/dev/null | head -1)"
    exit 0
fi

log INFO "Installing wslu via apt (needs sudo)..."
sudo apt-get update -qq
sudo apt-get install -y wslu
log SUCCESS "wslu installed: $(command -v wslview)"

{{ end -}}
