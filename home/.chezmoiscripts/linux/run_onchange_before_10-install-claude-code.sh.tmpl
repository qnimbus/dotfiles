#!/bin/bash

# Script: run_onchange_before_10-install-claude-code.sh
# Description: Install the Claude Code CLI on WSL Ubuntu with the official
#              native installer (installs to ~/.local/bin/claude and updates itself).
# Author: {{ .chezmoi.username }}
# Machine: {{ .chezmoi.hostname }}
# OS: {{ .chezmoi.os }}/{{ .chezmoi.arch }}
# Version: 1.0

{{ if and .wsl (eq .osid "linux-ubuntu") (not .ephemeral) -}}

set -euo pipefail

log() { echo "[$(date "+%Y-%m-%d %H:%M:%S")] [$1] ${*:2}"; }

# Look in ~/.local/bin too, since the installer puts claude there
export PATH="$HOME/.local/bin:$PATH"

# Skip the Windows claude.exe that WSL can see on the Windows PATH
if command -v claude &> /dev/null && [[ "$(command -v claude)" != /mnt/* ]]; then
    log INFO "Claude Code is already installed: $(command -v claude)"
else
    log INFO "Installing Claude Code with the native installer..."
    tmp_installer=$(mktemp)
    trap 'rm -f "$tmp_installer"' EXIT
    curl -fsSL https://claude.ai/install.sh -o "$tmp_installer"
    bash "$tmp_installer"
    log SUCCESS "Claude Code installed: $HOME/.local/bin/claude"
fi

{{ end -}}
