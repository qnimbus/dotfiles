#!/bin/bash

# Script: run_onchange_after_20-mise-install.sh
# Description: Installs the tools listed in the global mise config
# Author: {{ .chezmoi.username }}
# Machine: {{ .chezmoi.hostname }}
# OS: {{ .chezmoi.os }}/{{ .chezmoi.arch }}
# Version: 1.0

{{ if and (eq .osid "linux-ubuntu") (not .ephemeral) (not .headless) -}}

# mise config hash: {{ include "exact_dot_config/mise/config.toml" | sha256sum }}

set -euo pipefail  # Exit on error, undefined vars, pipe failures

# Default values
VERBOSE=false
INSTALL_DIR="$HOME/.local/bin"

# Function to display usage
usage() {
    cat << EOF
Usage: $0 [OPTIONS]

Description:
    Installs the tools listed in the global mise config (~/.config/mise/config.toml).
    Re-runs whenever that config changes in the chezmoi source state.

Options:
    -v, --verbose        Enable verbose output
    -h, --help          Display this help message

Examples:
    $0
    $0 --verbose

Notes:
    Requires: mise must be available in PATH or in ~/.local/bin
EOF
}

# Logging function
log() {
    local level="$1"
    shift
    local message="$*"
    local timestamp=$(date "+%Y-%m-%d %H:%M:%S")

    case "$level" in
        INFO)
            echo "[$timestamp] [INFO] $message"
            ;;
        WARN)
            echo "[$timestamp] [WARN] $message" >&2
            ;;
        ERROR)
            echo "[$timestamp] [ERROR] $message" >&2
            ;;
        SUCCESS)
            echo "[$timestamp] [SUCCESS] $message"
            ;;
        DEBUG)
            if [[ "$VERBOSE" == "true" ]]; then
                echo "[$timestamp] [DEBUG] $message"
            fi
            ;;
    esac
}

# Function to check prerequisites
check_prerequisites() {
    log INFO "Checking prerequisites..."

    # Check if mise is available
    if ! command -v mise &> /dev/null; then
        log ERROR "mise not found in PATH. Please ensure mise is installed."
        exit 1
    fi

    log SUCCESS "mise found: $(mise --version)"
    log SUCCESS "Prerequisites check completed"
}

# Function to install the tools from the mise config
install_tools() {
    log INFO "Installing tools from the mise config..."

    if ! mise install --yes; then
        log ERROR "Failed to install mise tools"
        return 1
    fi

    log SUCCESS "mise tools installed successfully"
    return 0
}

# Main function
main() {
    local script_name=$(basename "$0")

    log INFO "========================================"
    log INFO "STARTING: $script_name"
    log INFO "========================================"

    # Ensure ~/.local/bin is on PATH for this script
    case ":$PATH:" in
        *":$INSTALL_DIR:"*) ;;
        *) export PATH="$INSTALL_DIR:$PATH" ;;
    esac

    # Check prerequisites
    check_prerequisites

    # Install tools
    if ! install_tools; then
        log ERROR "mise tool installation failed"
        exit 1
    fi

    log DEBUG "Installed tools: $(mise ls --global 2>/dev/null | tr '\n' ';')"

    log SUCCESS "========================================"
    log SUCCESS "COMPLETED: $script_name"
    log SUCCESS "========================================"
}

# Cleanup function
cleanup() {
    local script_name=$(basename "$0")
    log INFO "Cleanup completed"
    log INFO "========================================"
    log INFO "EXITING: $script_name"
    log INFO "========================================"
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            log ERROR "Unknown option: $1"
            usage
            exit 1
            ;;
    esac
done

# Set up trap for cleanup on exit
trap cleanup EXIT

# Execute main function
main "$@"

{{ end -}}
