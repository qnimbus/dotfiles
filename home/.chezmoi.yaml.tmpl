{{/* boolean feature tags */}}
{{- $ephemeral := false -}}{{/* true if this machine is ephemeral, e.g. a cloud or VM instance */}}
{{- $headless := false -}}{{/* true if this machine does not have a screen and keyboard */}}
{{- $hostname := .chezmoi.hostname -}}
{{- $isWSL := false -}}{{/* Detect WSL2 using /proc/version and /proc/sys/fs/binfmt_misc/WSLInterop */}}
{{- "" -}}

{{- /* Detect WSL2 using /proc/version and /proc/sys/fs/binfmt_misc/WSLInterop */ -}}
{{- if and (eq .chezmoi.os "linux") (exec "grep" "-qi" "microsoft" "/proc/version") -}}
  {{- if (exec "test" "-f" "/proc/sys/fs/binfmt_misc/WSLInterop") -}}
    {{- $isWSL = true -}}
  {{- end -}}
{{- end -}}

{{- /* On WSL, find the Windows profile dir: the Windows username can differ
       from the Linux one. Falls back to /mnt/c/Users/<linux user>. */ -}}
{{- $winHome := "" -}}
{{- if $isWSL -}}
{{-   $winHome = output "sh" "-c" "p=$(cd /mnt/c && cmd.exe /d /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\\r'); [ -n \"$p\" ] && wslpath -u \"$p\" || true" | trim -}}
{{-   if not $winHome -}}
{{-     $winHome = printf "/mnt/c/Users/%s" .chezmoi.username -}}
{{-   end -}}
{{- end -}}

{{/* detect GitHub codespaces, VSCode remote containers, Docker containers, Multipass VMs, and Vagrant boxes */}}
{{- if or (env "CODESPACES") (env "REMOTE_CONTAINERS_IPC") (eq .chezmoi.username "root" "ubuntu" "vagrant" "vscode") -}}
{{-   $ephemeral = true -}}
{{- end -}}

{{- $osID := .chezmoi.os -}}
{{- if (and (eq .chezmoi.os "linux") (hasKey .chezmoi.osRelease "id")) -}}
{{-   $osID = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}

sourceDir: "{{ .chezmoi.homeDir }}/.dotfiles"

git:
  autopush: true

# Make chezmoi run PowerShell scripts in a way that ignores policy,
# uses 64-bit Windows PowerShell, and doesn't require any machine changes.
interpreters:
  ps1:
    command: "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
    args:
      - -NoProfile
      - -ExecutionPolicy
      - Bypass
      - -File

# Optional quality-of-life
edit:
  command: code
  args: ["--wait","--reuse-window"]

{{- if $isWSL }}
onepassword:
  command: "op.exe"
{{- end }}

data:
  ephemeral: {{ $ephemeral }}
  headless: {{ $headless }}
  hostname: {{ $hostname | quote }}
  osid: {{ $osID | quote }}
  wsl: {{ $isWSL }}
  winhome: {{ $winHome | quote }}
