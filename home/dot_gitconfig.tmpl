# ~/.gitconfig.tmpl

[init]
	defaultBranch = main

{{- /*
  Commit signing with 1Password's SSH signing program.

  Desktop machines that should always sign (Windows, WSL, macOS; not ephemeral
  or headless) always get signing on. The first existing program path wins; if
  none exists yet, the default path is used anyway so commits fail loudly
  instead of going out unsigned, and chezmoi prints a warning.

  Elsewhere (Codespaces, servers, native Linux without 1Password) signing is on
  only if the program exists; otherwise it's off, with a warning on non-ephemeral,
  non-headless machines.

  Classic installs live in Program Files; the Store (MSIX) version only exposes
  app aliases in WindowsApps. In WSL that's under the Windows profile
  (.winhome), since the Windows username can differ from the Linux one.
*/ -}}
{{- $desktop := and (not .ephemeral) (not .headless) -}}
{{- /* allowedSignersFile lets `git log --show-signature` verify commits; keep ~/.ssh/allowed_signers in sync with user.signingkey */ -}}
{{- $verify := or (eq .chezmoi.os "windows") .wsl -}}
{{- $mustSign := and $desktop (or (eq .chezmoi.os "windows") .wsl (eq .chezmoi.os "darwin")) -}}
{{- $candidates := list -}}
{{- $default := "" -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   $default = printf "%s/AppData/Local/Microsoft/WindowsApps/op-ssh-sign.exe" .chezmoi.homeDir -}}
{{-   $candidates = list "C:/Program Files/1Password/app/8/op-ssh-sign.exe" $default -}}
{{- else if .wsl -}}
{{-   $winHome := get . "winhome" | default (printf "/mnt/c/Users/%s" .chezmoi.username) -}}
{{-   $default = printf "%s/AppData/Local/Microsoft/WindowsApps/op-ssh-sign-wsl.exe" $winHome -}}
{{-   $candidates = list "/mnt/c/Program Files/1Password/app/8/op-ssh-sign-wsl" $default -}}
{{- else if eq .chezmoi.os "darwin" -}}
{{-   $default = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign" -}}
{{-   $candidates = list $default -}}
{{- else if eq .chezmoi.os "linux" -}}
{{-   $candidates = list "/opt/1Password/op-ssh-sign" -}}
{{- end -}}
{{- $signProgram := "" -}}
{{- range $candidates -}}
{{-   if and (not $signProgram) (stat .) -}}
{{-     $signProgram = . -}}
{{-   end -}}
{{- end -}}
{{- if and (not $signProgram) $mustSign -}}
{{-   $signProgram = $default -}}
{{-   warnf "1Password signing program not found; commits will fail until 1Password is installed at %s" $default -}}
{{- else if and (not $signProgram) $desktop -}}
{{-   warnf "1Password signing program not found; git commit signing is disabled on this machine" -}}
{{- end }}

[gpg]
	format = ssh

{{ if or $signProgram $verify -}}
[gpg "ssh"]
{{- if $signProgram }}
  program = "{{ $signProgram }}"
{{- end }}
{{- if $verify }}
  allowedSignersFile = ~/.ssh/allowed_signers
{{- end }}
{{- end }}

[worktree]
  guessRemote = true

[fetch]
  prune = true

[commit]
	gpgsign = {{ if $signProgram }}true{{ else }}false{{ end }}

[user]
	email = bas@vanwetten.com
	name = B. van Wetten
	# Keep your existing SSH signing key as-is
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJjtSV0bDhvCWCcKAD+Kece829AJvzZiaE207NAOaoti

[core]
	# Line-ending normalization (cross-platform safe)
	autocrlf = input
	eol = lf


{{ if and .wsl (not .ephemeral) -}}
	# WSL-specific SSH configuration
	sshCommand = ssh.exe
{{- end }}

{{- if eq .chezmoi.os "windows" }}
	# Windows-specific SSH configuration
	sshCommand = C:/Windows/System32/OpenSSH/ssh.exe -F "{{ .chezmoi.homeDir | replace "\\" "/" }}/.ssh/config"
{{- end }}

{{- if eq .chezmoi.os "windows" }}
[safe]
  directory = %(prefix)///wsl.localhost/Ubuntu-24.04/home/bas/dev
{{- end }}
